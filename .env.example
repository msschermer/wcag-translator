PORT=3000
NODE_ENV=production

APP_NAME=WCAG Translator
APP_VERSION=3.0.0

CORS_ORIGIN=*

# Number of proxy hops to trust. 1 = one reverse proxy (Caddy) in front.
# This MUST be a number. A hostname or CIDR list is also accepted.
TRUST_PROXY=1

PUBLIC_RATE_LIMIT=60
PUBLIC_RATE_WINDOW_MS=60000
API_RATE_LIMIT=300
API_RATE_WINDOW_MS=60000

MAX_QUERY_LENGTH=500
MAX_BODY_BYTES=20000

# Optional. Comma separated. Clients sending a valid key get the higher limit.
API_KEYS=

# Optional override for where generated data lives (used by the test suite).
WCAG_DATA_DIR=
